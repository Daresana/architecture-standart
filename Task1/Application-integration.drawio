"><mxGeometry as="geometry" x="1305" y="700" width="180" height="60" /></mxCell><mxCell id="label9" value="Отправка СМС" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=17;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1650" y="545" width="200" height="60" /></mxCell><mxCell id="label10" value="Ведёт обращения" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=17;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="910" width="320" height="55" /></mxCell><mxCell id="label11" value="Согласует заявку" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=17;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1150" y="915" width="210" height="55" /></mxCell><mxCell id="label12" value="Кредитные данные&#10;Отдельные права" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=17;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1375" y="885" width="310" height="80" /></mxCell><mxCell id="label13" value="Ежедневные ставки,&#10;оценка риска" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=17;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1305" y="1175" width="320" height="75" /></mxCell><mxCell id="label14" value="Расчёт и согласование" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=17;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="910" y="1220" width="210" height="70" /></mxCell><mxCell id="label15" value="Запрос ставки и ответ по почте" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=17;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="1145" width="470" height="55" /></mxCell><mxCell id="partner-note" value="Партнёрский кол-центр получает готовые скрипты от сотрудников банка. Автоматическая передача ставок в условии не описана. Обычная заявка в отделении занимает около 20 минут, заявка&#10;с особой ставкой — до часа. Кредитный и депозитный отделы имеют разные права доступа." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=20;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1450" width="1840" height="95" /></mxCell><mxCell id="title" value="Текущая интеграция приложений — открытие депозита" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=28;fontColor=#172a3a;spacing=10;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="15" width="1840" height="55" /></mxCell></root></mxGraphModel></diagram></mxfile>